---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import jimPortrait from '~/assets/images/gallery/jim.jpg';

const metadata = {
  title: 'Biography | Jim Matheos',
  description:
    'Biography of guitarist and composer Jim Matheos: founding member of Fates Warning, OSI, Arch / Matheos, Tuesday The Sky, Kings of Mercia, and North Sea Echoes.',
};

const projectMilestones = [
  {
    name: 'Fates Warning',
    role: 'Guitarist / Primary Songwriter',
    period: '1982 – Present',
    description:
      'Co-founded in 1982, Fates Warning pioneered progressive metal, crafting landmark albums like Awaken The Guardian, Perfect Symmetry, Parallels, A Pleasant Shade Of Gray, and Long Day Good Night.',
    link: 'https://fateswarning.com/',
  },
  {
    name: 'OSI',
    role: 'Guitarist / Co-founder / Producer',
    period: '2002 – Present',
    description:
      'Collaborative progressive rock project with former Dream Theater keyboardist Kevin Moore, featuring guest drummers Mike Portnoy and Gavin Harrison across four critically acclaimed studio albums.',
    link: 'https://osiband.net/',
  },
  {
    name: 'Arch / Matheos',
    role: 'Guitarist / Songwriter',
    period: '2010 – Present',
    description:
      'Reunion with original Fates Warning vocalist John Arch, releasing the progressive metal tours-de-force Sympathetic Resonance (2011) and Winter Ethereal (2019).',
    link: 'http://archmatheos.com/',
  },
  {
    name: 'North Sea Echoes',
    role: 'Guitarist / Programming / Producer',
    period: '2023 – Present',
    description:
      'Ambient, introspective collaboration with vocalist Ray Alder, crafting delicate acoustic textures, melancholy soundscapes, and cinematic arrangements on Really Good Terrible Things (2024) and How to Cast a Shadow (2026).',
    link: 'https://northseaechoes.com/',
  },
  {
    name: 'Tuesday The Sky',
    role: 'Multi-instrumentalist / Composer',
    period: '2017 – Present',
    description:
      'Instrumental post-rock, ambient, and electronica project exploring hypnotic grooves, expansive guitar atmospherics, and guest percussion by Gavin Harrison on Drift (2017) and The Blurred Horizon (2021).',
    link: 'https://tuesdaythesky.com/',
  },
  {
    name: 'Kings of Mercia',
    role: 'Guitarist / Songwriter',
    period: '2021 – Present',
    description:
      'High-energy hard rock powerhouse featuring vocalist Steve Overland (FM), drummer Simon Phillips (Toto, The Who), and bassist Joey Vera (Fates Warning, Armored Saint).',
    link: 'https://kingsofmercia.com/',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Header -->
  <HeroText title="Biography" tagline="Jim Matheos" />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-16">
    <!-- Artist Portrait Card -->
    <div
      class="rounded-2xl border border-neutral-300 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/40 p-6 sm:p-8 backdrop-blur-sm mb-12 flex flex-col md:flex-row items-center gap-8 shadow-sm"
    >
      <div
        class="relative w-48 h-48 sm:w-56 sm:h-56 rounded-2xl overflow-hidden shadow-2xl border-2 border-neutral-300 dark:border-neutral-700 shrink-0"
      >
        <Image src={jimPortrait} alt="Jim Matheos" class="object-cover w-full h-full" width={400} height={400} />
      </div>

      <div class="text-center md:text-left">
        <h2 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white font-heading">Jim Matheos</h2>
        <p class="text-neutral-600 dark:text-neutral-400 font-medium text-base mt-1">Guitarist · Composer · Producer</p>
        <div class="w-16 h-0.5 bg-neutral-300 dark:bg-neutral-600 my-4 mx-auto md:mx-0"></div>
        <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
          Over a four-decade career, Jim Matheos has established himself as one of modern music's most versatile,
          innovative, and influential guitarists. As the driving creative force and primary songwriter behind
          progressive metal pioneers Fates Warning, as well as visionary projects like OSI, Tuesday The Sky, Arch /
          Matheos, Kings of Mercia, and North Sea Echoes, Matheos has continually pushed the boundaries of progressive
          rock, ambient soundscapes, and heavy guitar music.
        </p>
        <div class="flex items-center justify-center md:justify-start gap-4 mt-5">
          <a
            href="https://www.facebook.com/JimMatheosOfficial"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors inline-flex items-center gap-1.5 text-xs font-semibold"
            aria-label="Jim Matheos Official Facebook"
          >
            <Icon name="tabler:brand-facebook" class="w-5 h-5 text-blue-500" />
            <span>Official Facebook</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Musical Journey & Narrative -->
    <div
      class="prose dark:prose-invert max-w-none space-y-6 text-neutral-700 dark:text-neutral-300 leading-relaxed text-sm sm:text-base"
    >
      <h3 class="text-2xl font-bold text-neutral-900 dark:text-white tracking-tight">The Architecture of Sound</h3>
      <p>
        Beginning in the early 1980s in Connecticut, Jim Matheos co-founded <strong>Fates Warning</strong>, transforming
        the underground American metal scene through intricate compositions, complex time signatures, and deep emotional
        resonance. Classic releases such as <em>Awaken The Guardian</em> (1986), <em>Perfect Symmetry</em> (1989), and <em
          >Parallels</em
        > (1991) cemented Matheos's reputation as a genre-defining composer. In 1997, he penned the 53-minute epic <em
          >A Pleasant Shade Of Gray</em
        >, universally recognized as a high-water mark for conceptual progressive metal.
      </p>

      <p>
        Beyond heavy distortion and technical complexity, Matheos has always cultivated a deep affinity for classical
        guitar, acoustic minimalism, and electronica. His solo acoustic releases—<em>First Impressions</em> (1993) and <em
          >Away With Words</em
        > (1999)—revealed an introspective instrumental voice, featuring delicate acoustic counterpoint, cello accompaniments,
        and evocative melodies.
      </p>

      <p>
        In the 2000s, Matheos joined forces with keyboardist Kevin Moore to create <strong>OSI</strong> (Office of Strategic
        Influence), an electro-progressive project that merged heavy guitar riffs with hypnotic synthesis, programmed percussion,
        and atmospheric sound design. Through four albums—featuring legendary rhythm sections including Mike Portnoy and Gavin
        Harrison—OSI challenged rock conventions and developed a passionate cult following.
      </p>

      <p>
        In recent years, Matheos's prolific output has accelerated across multiple distinct avenues: ambient
        instrumental textures with <strong>Tuesday The Sky</strong>, classic hard-rock melody with <strong
          >Kings of Mercia</strong
        >, and atmospheric singer-songwriter collaborations with longtime creative partner Ray Alder in <strong
          >North Sea Echoes</strong
        >.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="mt-14">
      <h3 class="text-2xl font-bold text-neutral-900 dark:text-white tracking-tight mb-6">
        Key Projects & Collaborations
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {
          projectMilestones.map((project) => (
            <div class="rounded-xl border border-neutral-300 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/40 p-6 backdrop-blur-sm flex flex-col justify-between shadow-sm">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h4 class="text-lg font-bold text-neutral-900 dark:text-white">{project.name}</h4>
                  <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">{project.period}</span>
                </div>
                <p class="text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-3">{project.role}</p>
                <p class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed">{project.description}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-neutral-200 dark:border-neutral-800/60">
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition inline-flex items-center gap-1 font-medium"
                >
                  <span>Visit website</span>
                  <Icon name="tabler:external-link" class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
