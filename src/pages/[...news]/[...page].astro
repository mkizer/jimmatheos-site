---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import ProjectFilter from '~/components/news/ProjectFilter.astro';
import AggregatedNewsCard from '~/components/news/AggregatedNewsCard.astro';
import { PROJECT_FEEDS } from '~/data/feeds.config';
import type { AggregatedPost } from '~/types';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogList();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts } = Astro.props as Props;

const filterSources = [
  { id: 'jim-matheos', name: 'Jim Matheos' },
  ...PROJECT_FEEDS.map((f) => ({ id: f.id, name: f.name })),
];

const metadata = {
  title: 'News & Updates',
  description: "Latest news, announcements, and updates across Jim Matheos's projects.",
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-5xl">
    <Headline subtitle="Latest news, announcements, and updates across all projects"> News & Updates </Headline>

    {/* Facebook Social Stream Connection Card */}
    <div
      class="mb-8 p-4 sm:p-5 rounded-xl border border-neutral-800 bg-neutral-900/60 backdrop-blur-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4"
    >
      <div class="flex items-center gap-3.5">
        <div
          class="w-10 h-10 rounded-full bg-blue-600/20 border border-blue-500/40 flex items-center justify-center shrink-0 text-blue-400"
        >
          <Icon name="tabler:brand-facebook" class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white">Jim Matheos Official Facebook</h3>
          <p class="text-xs text-neutral-400">
            Follow Jim's official Facebook profile for personal notes, updates, and photos.
          </p>
        </div>
      </div>
      <a
        href="https://www.facebook.com/JimMatheosOfficial"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-neutral-800 hover:bg-neutral-700 text-white border border-neutral-700 transition shrink-0"
      >
        <span>View Facebook Page</span>
        <Icon name="tabler:external-link" class="w-3.5 h-3.5 text-neutral-400" />
      </a>
    </div>

    {/* Progressive Enhancement Filter */}
    <ProjectFilter
      sources={filterSources}
      pageSize={12}
      gridSelector="#news-grid"
      targetSelector="[data-news-item]"
      paginationSelector="#news-pagination"
    />

    {/* Aggregated Grid */}
    <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {posts.map((post: AggregatedPost) => <AggregatedNewsCard post={post} />)}
    </div>

    <div id="news-empty-message" style="display: none;" class="text-center py-12 text-neutral-400 text-sm">
      No updates found for the selected project.
    </div>

    {/* Dynamic Client-Side Pagination Controls */}
    <div id="news-pagination" class="mt-8" style="display: none;">
      <div class="flex flex-row items-center justify-between container mx-auto">
        <button
          type="button"
          data-page-prev
          class="inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium transition border border-neutral-700 bg-neutral-900 text-neutral-300 hover:border-neutral-500 hover:text-white disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
        >
          <Icon name="tabler:chevron-left" class="w-5 h-5 mr-1" />
          <span>Newer updates</span>
        </button>

        <span data-page-indicator class="text-sm text-neutral-400 font-medium"> Page 1 of 1 </span>

        <button
          type="button"
          data-page-next
          class="inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium transition border border-neutral-700 bg-neutral-900 text-neutral-300 hover:border-neutral-500 hover:text-white disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
        >
          <span>Older updates</span>
          <Icon name="tabler:chevron-right" class="w-5 h-5 ml-1" />
        </button>
      </div>
    </div>
  </section>
</Layout>
