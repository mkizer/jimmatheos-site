---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-12 sm:px-6 mx-auto lg:px-8 lg:py-16 max-w-4xl">
    <h1
      class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter text-neutral-900 dark:text-white"
    >
      {frontmatter.title}
    </h1>
    <div class="w-16 h-0.5 bg-neutral-300 dark:bg-neutral-700 mt-6"></div>
    <div
      class="mx-auto prose prose-neutral dark:prose-invert max-w-4xl prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-headings:text-neutral-900 dark:prose-headings:text-white prose-a:text-neutral-900 dark:prose-a:text-white prose-a:underline prose-a:decoration-neutral-400 hover:prose-a:decoration-neutral-900 dark:prose-a:decoration-neutral-500 dark:hover:prose-a:decoration-white prose-strong:text-neutral-900 dark:prose-strong:text-white prose-img:rounded-md prose-img:shadow-lg mt-8"
    >
      <slot />
    </div>
  </section>
</Layout>
