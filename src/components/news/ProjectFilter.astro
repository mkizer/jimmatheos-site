---
export interface Props {
  sources: Array<{ id: string; name: string }>;
  selectedSource?: string;
  pageSize?: number;
  targetSelector?: string;
  gridSelector?: string;
  paginationSelector?: string;
}

const {
  sources,
  selectedSource = 'all',
  pageSize = 12,
  targetSelector = '[data-news-item]',
  gridSelector = '#news-grid',
  paginationSelector = '#news-pagination',
} = Astro.props;
---

<project-filter
  data-target={targetSelector}
  data-grid={gridSelector}
  data-pagination={paginationSelector}
  data-page-size={pageSize}
  class="block mb-8"
>
  <div class="flex flex-wrap gap-2 items-center" role="group" aria-label="Filter news by project">
    <span class="text-xs uppercase tracking-wider text-neutral-400 font-semibold mr-1">Filter:</span>
    <button
      type="button"
      data-filter="all"
      aria-pressed={selectedSource === 'all' ? 'true' : 'false'}
      class="px-3.5 py-1.5 rounded-full text-xs font-medium transition-all duration-200 border border-neutral-700 bg-neutral-900 text-neutral-300 hover:border-neutral-500 hover:text-white aria-pressed:bg-white aria-pressed:text-neutral-950 aria-pressed:border-white cursor-pointer"
    >
      All Projects
    </button>
    {
      sources.map((src) => (
        <button
          type="button"
          data-filter={src.id}
          aria-pressed={selectedSource === src.id ? 'true' : 'false'}
          class="px-3.5 py-1.5 rounded-full text-xs font-medium transition-all duration-200 border border-neutral-700 bg-neutral-900 text-neutral-300 hover:border-neutral-500 hover:text-white aria-pressed:bg-white aria-pressed:text-neutral-950 aria-pressed:border-white cursor-pointer"
        >
          {src.name}
        </button>
      ))
    }
  </div>
</project-filter>

<script>
  class ProjectFilter extends HTMLElement {
    connectedCallback() {
      const targetSelector = this.dataset.target || '[data-news-item]';
      const gridSelector = this.dataset.grid || '#news-grid';
      const paginationSelector = this.dataset.pagination || '#news-pagination';
      const pageSize = parseInt(this.dataset.pageSize || '12', 10);

      const buttons = this.querySelectorAll<HTMLButtonElement>('button[data-filter]');
      const paginationContainer = document.querySelector<HTMLElement>(paginationSelector);
      const prevBtn = paginationContainer?.querySelector<HTMLButtonElement>('[data-page-prev]');
      const nextBtn = paginationContainer?.querySelector<HTMLButtonElement>('[data-page-next]');
      const indicator = paginationContainer?.querySelector<HTMLElement>('[data-page-indicator]');
      const emptyMsg = document.getElementById('news-empty-message');
      const gridEl = document.querySelector<HTMLElement>(gridSelector);

      let currentFilter = 'all';
      let currentPage = 1;

      const render = (scrollToTop = false) => {
        // 1. Update filter button pressed state
        buttons.forEach((btn) => {
          const isActive = btn.dataset.filter === currentFilter;
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        // 2. Filter matching items
        const allItems = Array.from(document.querySelectorAll<HTMLElement>(targetSelector));
        const matchingItems = allItems.filter((item) => {
          const sourceId = item.dataset.sourceId;
          return currentFilter === 'all' || sourceId === currentFilter;
        });

        const totalItems = matchingItems.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));

        // Clamp currentPage within valid range
        if (currentPage > totalPages) {
          currentPage = totalPages;
        }
        if (currentPage < 1) {
          currentPage = 1;
        }

        // 3. Show/hide empty message
        if (emptyMsg) {
          emptyMsg.style.display = totalItems === 0 ? 'block' : 'none';
        }

        // 4. Update visibility of items based on page slice
        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = startIndex + pageSize;

        // Hide items that don't match the current filter
        allItems.forEach((item) => {
          item.style.display = 'none';
        });

        // Display matching items within the current page window
        matchingItems.forEach((item, index) => {
          if (index >= startIndex && index < endIndex) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });

        // 5. Update pagination controls
        if (paginationContainer) {
          if (totalPages <= 1) {
            paginationContainer.style.display = 'none';
          } else {
            paginationContainer.style.display = '';

            if (indicator) {
              indicator.textContent = `Page ${currentPage} of ${totalPages}`;
            }

            if (prevBtn) {
              prevBtn.disabled = currentPage <= 1;
            }

            if (nextBtn) {
              nextBtn.disabled = currentPage >= totalPages;
            }
          }
        }

        // 6. Smoothly scroll to top of news grid when navigating pages
        if (scrollToTop && gridEl) {
          const gridTop = gridEl.getBoundingClientRect().top + window.scrollY - 100;
          window.scrollTo({ top: gridTop, behavior: 'smooth' });
        }

        // 7. Sync with URL search params
        const url = new URL(window.location.href);
        if (currentFilter === 'all') {
          url.searchParams.delete('source');
        } else {
          url.searchParams.set('source', currentFilter);
        }

        if (currentPage > 1) {
          url.searchParams.set('page', String(currentPage));
        } else {
          url.searchParams.delete('page');
        }
        window.history.replaceState({}, '', url.toString());
      };

      // Filter button listeners
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter || 'all';
          if (filter !== currentFilter) {
            currentFilter = filter;
            currentPage = 1;
            render(false);
          }
        });
      });

      // Pagination button listeners
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            render(true);
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentPage++;
          render(true);
        });
      }

      // Initialize state from URL search params if present
      const params = new URLSearchParams(window.location.search);
      const initialSource = params.get('source');
      const initialPage = parseInt(params.get('page') || '1', 10);

      if (initialSource) {
        currentFilter = initialSource;
      }
      if (!isNaN(initialPage) && initialPage > 1) {
        currentPage = initialPage;
      }

      render(false);
    }
  }

  if (!customElements.get('project-filter')) {
    customElements.define('project-filter', ProjectFilter);
  }
</script>
