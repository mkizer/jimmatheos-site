---
import { Icon } from 'astro-icon/components';
import type { AggregatedPost } from '~/types';

export interface Props {
  post: AggregatedPost;
}

const { post } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(post.publishDate);

// Badge styling helper based on source
const getBadgeClass = (sourceId: string) => {
  switch (sourceId) {
    case 'north-sea-echoes':
      return 'bg-sky-100 text-sky-800 border-sky-300 dark:bg-sky-950/80 dark:text-sky-300 dark:border-sky-800/60';
    case 'kings-of-mercia':
      return 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950/80 dark:text-amber-300 dark:border-amber-800/60';
    case 'tuesday-the-sky':
      return 'bg-indigo-100 text-indigo-800 border-indigo-300 dark:bg-indigo-950/80 dark:text-indigo-300 dark:border-indigo-800/60';
    default:
      return 'bg-neutral-200 text-neutral-800 border-neutral-300 dark:bg-zinc-800 dark:text-zinc-200 dark:border-zinc-700';
  }
};
---

<article
  data-news-item
  data-source-id={post.sourceId}
  class="group relative rounded-xl border border-neutral-300 dark:border-neutral-800 bg-white/80 dark:bg-neutral-900/40 p-6 backdrop-blur-sm transition-all duration-300 hover:border-neutral-400 dark:hover:border-neutral-700 hover:bg-white dark:hover:bg-neutral-900/70 hover:shadow-lg hover:shadow-black/5 dark:hover:shadow-black/30"
>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <span
      class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${getBadgeClass(post.sourceId)}`}
    >
      {post.source}
    </span>
    <time datetime={post.publishDate.toISOString()} class="text-xs text-neutral-500 dark:text-neutral-400">
      {formattedDate}
    </time>
  </div>

  <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white transition-colors group-hover:text-neutral-700 dark:group-hover:text-neutral-200">
    <a
      href={post.link}
      target={post.isExternal ? '_blank' : undefined}
      rel={post.isExternal ? 'noopener noreferrer' : undefined}
      class="inline-flex items-center gap-1.5 focus:outline-none focus:underline"
    >
      <span>{post.title}</span>
      {
        post.isExternal && (
          <Icon
            name="tabler:external-link"
            class="w-4 h-4 text-neutral-400 shrink-0 inline-block opacity-75 group-hover:opacity-100 transition-opacity"
          />
        )
      }
    </a>
  </h2>

  {post.excerpt && <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed line-clamp-3">{post.excerpt}</p>}

  <div class="mt-4 pt-3 border-t border-neutral-200 dark:border-neutral-800/60 flex items-center justify-between text-xs">
    <a
      href={post.link}
      target={post.isExternal ? '_blank' : undefined}
      rel={post.isExternal ? 'noopener noreferrer' : undefined}
      class="font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors inline-flex items-center gap-1"
    >
      {post.isExternal ? 'Read on project site' : 'Read article'} &rarr;
    </a>
    {post.isExternal && <span class="text-neutral-500 dark:text-neutral-400 text-[11px] italic">External Feed</span>}
  </div>
</article>
