---
import { Image } from 'astro:assets';
import guitargeekImg from '~/assets/images/jim_guitargeek_2012.jpg';
import guitarworldImg from '~/assets/images/jim_guitarworld_2012.jpg';

const diagrams = [
  {
    id: 'guitargeek-2012',
    title: 'Guitar Geek Rig Diagram (2012)',
    description:
      'Detailed schematic of Jim Matheos’s complete touring and studio guitar routing, pedalboard, preamps, and Mesa Boogie amplification chain.',
    image: guitargeekImg,
  },
  {
    id: 'guitarworld-2012',
    title: 'Guitar World Rig Diagram (2012)',
    description:
      'Guitar World magazine feature illustrating Jim’s signal flow, effects loops, rack units, and cabinet setups for live performances.',
    image: guitarworldImg,
  },
];
---

<div class="mb-16">
  <div class="mb-8">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Live Rig Diagrams</h2>
    <p class="mt-2 text-sm text-neutral-400">
      Click on any diagram to view full-resolution schematics and signal routings.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      diagrams.map((diag, index) => (
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 backdrop-blur-sm flex flex-col justify-between">
          <div>
            <button
              type="button"
              onclick={`document.getElementById('rig-dialog-${index}').showModal()`}
              class="w-full overflow-hidden rounded-xl border border-neutral-800 bg-neutral-950 transition-all duration-300 hover:border-neutral-600 hover:scale-[1.01] block cursor-pointer group"
            >
              <Image
                src={diag.image}
                alt={diag.title}
                width={800}
                class="w-full h-auto object-contain transition-transform duration-300 group-hover:scale-105"
              />
            </button>
            <h3 class="mt-4 text-lg font-bold text-white">{diag.title}</h3>
            <p class="mt-2 text-xs text-neutral-300 leading-relaxed">{diag.description}</p>
          </div>

          <div class="mt-4 pt-3 border-t border-neutral-800/60">
            <button
              type="button"
              onclick={`document.getElementById('rig-dialog-${index}').showModal()`}
              class="text-xs font-semibold text-neutral-300 hover:text-white transition flex items-center gap-1 cursor-pointer"
            >
              <span>Click to view full schematic</span> &rarr;
            </button>
          </div>

          {/* Modal Lightbox for High-Res View */}
          <dialog
            id={`rig-dialog-${index}`}
            class="fixed inset-0 z-50 p-0 m-auto bg-transparent backdrop:bg-black/90 backdrop:backdrop-blur-md max-w-[95vw] max-h-[95vh] rounded-2xl overflow-hidden focus:outline-none"
            onclick="this.close()"
          >
            <form method="dialog" class="relative flex flex-col justify-between max-h-[95vh]">
              <button
                type="submit"
                class="absolute top-4 right-4 z-50 bg-black/80 text-white hover:bg-neutral-800 w-10 h-10 rounded-full flex items-center justify-center text-lg font-bold transition border border-neutral-700 cursor-pointer"
              >
                ✕
              </button>

              <div
                class="p-4 sm:p-6 overflow-auto max-h-[82vh] flex items-center justify-center"
                onclick="arguments[0]?.stopPropagation()"
              >
                <Image
                  src={diag.image}
                  alt={diag.title}
                  width={1800}
                  class="max-w-none w-auto max-h-[80vh] object-contain rounded drop-shadow-2xl"
                />
              </div>

              <div
                class="w-full bg-neutral-950/95 backdrop-blur-md p-4 text-center border-t border-neutral-800 text-white"
                onclick="arguments[0]?.stopPropagation()"
              >
                <h4 class="text-sm font-bold text-white">{diag.title}</h4>
                <p class="text-xs text-neutral-400 mt-1 max-w-xl mx-auto">{diag.description}</p>
              </div>
            </form>
          </dialog>
        </div>
      ))
    }
  </div>
</div>
